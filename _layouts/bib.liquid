---
---
{%- comment -%}
  Local override of al_folio_core's _layouts/bib.liquid.

  Renders each reference in the "academic personal site" layout rather than a
  journal-style reference list: a venue chip in a left gutter, then title-first
  content so the thing a visitor scans for is the most prominent element.

      [ chip ]   Title of the paper
                 Author One, Author Two, and Author Three · 2026
                 Journal Name, 108(4), 897–913
                 [status pill]  NBER Working Paper 34383
                 PDF  Bib

  Keeps the .row wrapper + entry anchor id (bibsearch filters on the parent
  `ol.bibliography > li`, and the id backs deep links), the link buttons, and
  the hidden BibTeX block. The BibTeX toggle in common.js resolves its scope as
  `.links`'s parentElement, so `.links` and `.bibtex.hidden` must stay siblings.

  Styling lives in _pages/publications.md.
{%- endcomment -%}
<div class="row">
  <div id="{{ entry.key }}" class="col-12 pub-entry">
    {%- comment -%} ===== Venue chip (left gutter) ===== {%- endcomment -%}
    <div class="pub-chip-col">
      {%- if entry.abbr -%}<span class="pub-chip">{{ entry.abbr }}</span>{%- endif -%}
    </div>

    <div class="pub-body">
      {%- comment -%} ===== Title ===== {%- endcomment -%}
      <div class="pub-title">{{ entry.title }}</div>

      {%- comment -%} ===== Authors (natural order, self emphasised) ===== {%- endcomment -%}
      <div class="pub-authors">
        {%- assign author_array_size = entry.author_array | size -%}
        {%- for author in entry.author_array -%}
          {%- assign author_is_self = false -%}
          {%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
          {%- if site.scholar.last_name contains author_last_name -%}
            {%- if site.scholar.first_name contains author.first -%}
              {%- assign author_is_self = true -%}
            {%- endif -%}
          {%- endif -%}
          {%- comment -%} separators between names {%- endcomment -%}
          {%- unless forloop.first -%}
            {%- if author_array_size > 2 -%}, {% endif -%}
            {%- if forloop.last -%}{%- if author_array_size == 2 -%}, and {% else %}and {% endif -%}{%- endif -%}
          {%- endunless -%}
          {%- comment -%}
            Surname including any von particle ("de", "van der", ...). BibTeX parses
            "de Hoyos, Rafael" as von="de" + last="Hoyos", and the `latex` bibtex
            filter strips the {de Hoyos} braces that would normally protect it, so
            printing author.last alone drops the particle. Falls back silently to
            author.last when von is absent or unexposed.
          {%- endcomment -%}
          {%- capture von_last -%}{% if author.von and author.von != '' %}{{ author.von }} {% endif %}{{ author.last }}{%- endcapture -%}
          {%- if author_is_self -%}<span class="pub-self">{{ author.first }} {{ von_last }}</span>
          {%- else -%}{{ author.first }} {{ von_last }}
          {%- endif -%}
        {%- endfor -%}
        {%- if entry.year %}<span class="pub-year">{{ entry.year }}</span>{% endif -%}
      </div>

      {%- comment -%} ===== Venue ===== {%- endcomment -%}
      {%- assign pages = entry.pages | replace: '--', '–' -%}
      {%- if entry.type == 'article' -%}
        <div class="pub-venue">
          <em>{{ entry.journal }}</em>
          {%- if entry.volume %} {{ entry.volume }}{% endif -%}
          {%- if entry.number %}({{ entry.number }}){% endif -%}
          {%- if entry.pages %}, {{ pages }}{% endif -%}
        </div>
      {%- elsif entry.institution -%}
        {%- comment -%}
          Reports (@techreport). Keyed off `institution` rather than `entry.type`:
          jekyll-scholar does not surface 'techreport' as entry.type here, so the
          old `entry.type == 'techreport'` test never matched and reports rendered
          with no venue line at all. `institution` is present on reports and on
          nothing else in this bibliography, so it is a reliable discriminator.
        {%- endcomment -%}
        <div class="pub-venue">
          {{ entry.institution }}
          {%- if entry.series %} {{ entry.series }}{% endif -%}
          {%- if entry.number %} {{ entry.number }}{% endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} ===== Status pill + note ===== {%- endcomment -%}
      {%- if entry.status or entry.note -%}
        <div class="pub-meta">
          {%- if entry.status -%}
            {%- assign status_slug = entry.status | downcase | replace: ' ', '-' -%}
            <span class="pub-status pub-status--{{ status_slug }}">{{ entry.status }}</span>
          {%- endif -%}
          {%- if entry.note %}<span class="pub-note">{{ entry.note }}</span>{% endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} ===== Link buttons ===== {%- endcomment -%}
      <span class="links">
        {%- if entry.doi -%}
          <a href="https://doi.org/{{ entry.doi }}" class="btn btn-sm z-depth-0" role="button">DOI</a>
        {%- endif -%}
        {%- if entry.html -%}
          {%- if entry.html contains '://' -%}
            <a href="{{ entry.html }}" class="btn btn-sm z-depth-0" role="button">HTML</a>
          {%- else -%}
            <a href="{{ entry.html | prepend: '/assets/html/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">HTML</a>
          {%- endif -%}
        {%- endif -%}
        {%- if entry.pdf -%}
          {%- if entry.pdf contains '://' -%}
            <a href="{{ entry.pdf }}" class="btn btn-sm z-depth-0" role="button">PDF</a>
          {%- else -%}
            <a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">PDF</a>
          {%- endif -%}
        {%- endif -%}
        {%- if entry.press -%}
          <a href="{{ entry.press }}" class="btn btn-sm z-depth-0" role="button" title="Palladium Magazine">Press Coverage</a>
        {%- endif -%}
        {%- if entry.slides -%}
          {%- if entry.slides contains '://' -%}
            <a href="{{ entry.slides }}" class="btn btn-sm z-depth-0" role="button">Slides</a>
          {%- else -%}
            <a href="{{ entry.slides | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">Slides</a>
          {%- endif -%}
        {%- endif -%}
        {%- if entry.code -%}
          <a href="{{ entry.code }}" class="btn btn-sm z-depth-0" role="button">Code</a>
        {%- endif -%}
        {%- if entry.bibtex_show -%}
          <a class="bibtex btn btn-sm z-depth-0" role="button">Bib</a>
        {%- endif -%}
      </span>

      {%- if entry.bibtex_show -%}
        <div class="bibtex hidden">
          {% highlight bibtex %}{{ entry.bibtex | hideCustomBibtex }}{% endhighlight %}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
